{
    "name": "horde/activesync",
    "description": "ActiveSync server library",
    "type": "horde-library",
    "homepage": "https://www.horde.org/libraries/Horde_ActiveSync",
    "license": "GPL-2.0-only",
    "authors": [
        {
            "name": "Michael J Rubinsky",
            "email": "mrubinsk@horde.org",
            "role": "lead"
        }
    ],
    "keywords": [
        "contacts",
        "outlook",
        "sync",
        "eas",
        "exchange"
    ],
    "time": "2026-06-11",
    "repositories": [],
    "require": {
        "horde/horde-installer-plugin": "^3 || ^2",
        "php": "^7.4 || ^8",
        "horde/compress": "^3",
        "horde/date": "^3",
        "horde/exception": "^3",
        "horde/icalendar": "^3",
        "horde/log": "^3",
        "horde/mapi": "^2",
        "horde/mime": "^3",
        "horde/stream": "^2",
        "horde/support": "^3",
        "horde/translation": "^3",
        "horde/util": "^3",
        "ext-ctype": "*"
    },
    "require-dev": {
        "horde/db": "^3",
        "horde/imap_client": "^3"
    },
    "suggest": {
        "horde/db": "^3",
        "horde/imap_client": "^3",
        "horde/mail": "^3",
        "horde/mongo": "^2",
        "horde/text_filter": "^3"
    },
    "autoload": {
        "psr-0": {
            "Horde_ActiveSync": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\ActiveSync\\": [
                "test/unit/Horde/ActiveSync/",
                "test/integration/Horde/ActiveSync/"
            ],
            "Horde\\ActiveSync\\Test\\Helpers\\": "test/unit/Horde/ActiveSync/Helpers/"
        }
    },
    "config": {
        "allow-plugins": {
            "horde/horde-installer-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": false
}
